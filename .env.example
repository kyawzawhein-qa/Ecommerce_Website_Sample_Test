# Copy to `.env` for local overrides. Defaults target the in-repo fixture storefront.

# Application under test (Playwright webServer also serves the fixture on this URL)
BASE_URL=http://127.0.0.1:3000
FIXTURE_PORT=3000

# Credentials used by positive login tests (fixture server validates these)
TEST_USERNAME=testuser@example.com
TEST_PASSWORD=ValidP@ssw0rd!

# Timeouts (milliseconds)
BROWSER_TIMEOUT=30000
ACTION_TIMEOUT=15000

# Optional tag filter for npm scripts (e.g. @smoke, @regression, @api)
# TEST_TAG=@smoke